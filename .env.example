# REQUIRED — agent reasoning, vision QC, and multimodal similarity
GEMINI_API_KEY=
GEMINI_AGENT_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# REQUIRED — image generation and revision
FAL_KEY=
FAL_GENERATION_MODEL=fal-ai/flux-2/klein/4b/base/edit
GENERATION_COST_ESTIMATE_USD=0.018

# REQUIRED — durable state and job queue
DATABASE_URL=postgresql://user:password@host:5432/database
REDIS_URL=rediss://default:password@host:6379

# REQUIRED — source, reference, and generated image storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=creative-qc

# SERVER-SIDE GUARDRAILS
COST_CAP_USD_PER_BATCH=5
COST_CAP_USD_PER_ASSET=0.5
MAX_ATTEMPTS_PER_ASSET=5
FEEDBACK_RETRIES=2
QC_PASS_SCORE=80
WORKER_CONCURRENCY=4
BATCH_CREATION_LIMIT_PER_HOUR=5
PROVIDER_TIMEOUT_MS=180000

# APP / DEPLOYMENT
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_MODE=true
LOG_LEVEL=info
