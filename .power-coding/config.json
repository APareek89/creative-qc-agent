{
  "version": "1.0.0",
  "setup_defaults": "⚠️ unconfirmed — selected for the requested non-interactive build",
  "consent": {
    "git_checkpoints": "propose",
    "fmea_full_scan": "auto",
    "paid_evals": "ask"
  },
  "modules": {
    "fmea": {
      "enabled": true,
      "pin_to_commit": true,
      "triggers": {
        "on_feature_complete": true,
        "on_pre_commit": true,
        "smart_suggest": true,
        "manual_only": false
      },
      "smart_suggest_signals": [
        "diff_exceeds_lines:200",
        "new_external_api_integration",
        "payment_billing_logic_touched",
        "async_queue_worker_modified",
        "error_handling_changed",
        "auth_access_control_touched",
        "database_migration_added",
        "environment_config_changed",
        "new_webhook_handler",
        "retry_logic_modified"
      ],
      "scoring": { "p0_threshold": 200, "p1_threshold": 100, "p2_threshold": 0 },
      "failure_categories": [
        "unhandled_error_paths",
        "external_dependency_failures",
        "race_conditions_and_state",
        "resource_exhaustion",
        "security_access_control",
        "data_integrity_partial_writes",
        "observability_gaps",
        "scale_and_load_failures",
        "billing_credit_mismatches",
        "retry_idempotency_issues",
        "config_feature_flag_drift",
        "edge_cases_from_prd"
      ],
      "context_sources": {
        "prd_path": "Creative-QC-Agent-PRD.md",
        "architecture_doc": "docs/ARCHITECTURE_FLOW.md",
        "known_incidents": "Learning.MD",
        "infra_constraints": "SCALING.md"
      },
      "output": {
        "format": "markdown_table",
        "include_rpn": true,
        "include_recommended_actions": true,
        "include_priority_badges": true,
        "max_failure_modes": 25,
        "sort_by": "rpn_desc"
      }
    },
    "secret_scan": {
      "enabled": true,
      "block_on_hit": true,
      "runs_on": "on_pre_commit + day-one baseline"
    },
    "sentinel": { "enabled": true, "manual_only": false },
    "session_pulse": { "enabled": true },
    "security_baseline": { "done": true, "completed_date": "2026-07-17" }
  }
}
